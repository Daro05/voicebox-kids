# Create a bot with Telegram's BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=replace-me

# Comma-separated numeric chat IDs allowed to send voice notes.
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Destination for recordings made on the device. It must also appear above.
# Optional when only one chat is allowed.
TELEGRAM_OUTBOUND_CHAT_ID=123456789

# Voice notes are downloaded here. The directory is ignored by Git.
VOICEBOX_INBOX_DIR=data/inbox
VOICEBOX_OUTBOX_DIR=data/outbox

# Optional explicit player command. Leave empty for automatic detection.
# ffplay is recommended for Telegram's Ogg/Opus format.
# Other supported commands: paplay, mpg123, afplay
VOICEBOX_AUDIO_PLAYER=

# macOS AVFoundation audio device. :0 selects audio device 0.
VOICEBOX_AUDIO_INPUT=:0

# Retry a failed local playback once (2 total attempts).
VOICEBOX_PLAYBACK_ATTEMPTS=2

# Retry a failed Telegram upload once (2 total attempts).
VOICEBOX_SEND_ATTEMPTS=2

# Delete downloaded audio older than this many hours when VoiceBox starts.
VOICEBOX_MEDIA_RETENTION_HOURS=24
